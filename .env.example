# ==================== 服务端 ====================
# 监听地址。0.0.0.0 允许局域网内其他机器连接；只想本机测试填 127.0.0.1。
CHAT_HOST=0.0.0.0
CHAT_PORT=10086

# 数据库路径。不填则用 <项目根>/database/chat.db。
# 警告：写成空值 "CHAT_DB_PATH=" 会被当成空字符串，sqlite 会打开一个**临时库**，而且每个线程一个连接、
# 重启即丢数据。要用默认值就把整行注释掉，不要留空。
# CHAT_DB_PATH=D:/Code/计网课设/database/chat.db

# ==================== 图片消息 ====================
# 图片本体走内置 HTTP 服务（聊天协议的帧长度是 uint16，塞不下照片）。
# HTTP 端口：前端会从桥那里拿到 http://<服务端地址>:<这个端口>，用来上传和显示图片。
CHAT_IMAGE_PORT=10087
# 图片落盘目录，不填则用 <数据库所在目录>/images。
# CHAT_IMAGE_DIR=D:/Code/计网课设/database/images
# 单张图片字节上限（默认 8 MB）。客户端会先把图片压到最大边 1280 再上传。
CHAT_IMAGE_MAX_BYTES=8388608

# ==================== 大模型 ====================
# OpenAI 兼容接口的 Key。留空也能启动：聊天室收发正常，只是 Agent 会回一句"暂不可用"。
LLM_API_KEY=
# 第三方兼容接口填完整地址（一般带 /v1）。用官方接口请把整行**注释掉**。
LLM_BASE_URL=
# 模型 ID，必须与服务商提供的名称一致。
# 例：gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL_ID=

# ==================== 联网搜索（Agent 可选工具） ====================
# Tavily API Key，仅 tavily_search 工具用到。留空则 Agent 仍可启动，
# 只是调用联网搜索时返回工具错误、改用自身知识回答。
TAVILY_API_KEY=

# ==================== 管理员 ====================
# 能禁言/解禁的人，逗号分隔（例：ADMIN_USERS=alice,bob）。留空则没人有权限。
ADMIN_USERS=

# ==================== Agent 行为 ====================
# ReAct 最大循环步数：模型最多几轮「调工具 → 看结果」。太小容易中途截断，太大容易被反复搜索拖慢。
AGENT_MAX_STEPS=5
# Agent 超时秒数。当前仅用于失败提示文案，并未真正中断模型调用（见 README「已知限制」）。
AGENT_TIMEOUT=60

# ==================== Agent 定时总结 ====================
# 服务端启动时默认的定时间隔（秒）。0 = 关闭，客户端可用 /auto 5 临时开启。
AGENT_AUTO_SUMMARY_SECONDS=0
# 自动总结的门槛：至少要积累这么多条"人发的新消息"才总结，免得两句话也总结一遍。
# 客户端点「立即总结」/ 发 /auto now 属于手动触发，不受这个门槛限制。
AGENT_AUTO_SUMMARY_MIN_MESSAGES=3

# ==================== 其他 ====================
# 单次读取历史条数的默认上限。当前代码定义了但尚未被使用（见 README「已知限制」）。
MAX_HISTORY=20
