# 环境变量（含真实密钥，绝不提交）
.env
server/.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 运行时产物：数据库和图片都由服务端自动创建
database/*.db
database/*.db-shm
database/*.db-wal
database/images/

# 前端依赖（dist 是构建产物，为了让没装 Node 的机器也能直接跑，特意提交）
client/web/node_modules/
client/web/.vite/

# 编辑器 / 本地工具
.idea/
.vscode/
.config/
*.log
nul
